# ── Kalshi credentials (this account trades REAL money in LIVE mode) ─────────
KALSHI_ENV=production
KALSHI_KEY_ID=your-kalshi-api-key-id
# Path to your RSA private key PEM (recommended — avoids multi-line in .env):
KALSHI_PRIVATE_KEY_PATH=./kalshi_rsa.pem
# ...or inline it instead (escape newlines as \n):
# KALSHI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----

# Isolated data/credential dir for this script (kept away from the app's store)
ST_USERDATA=./.staleness_data

# ── SAFETY: stays paper until you flip this to 1 ────────────────────────────
ST_LIVE=0

# ── Signal (validated regime: >=8bp move, book stale <=2c) ──────────────────
ST_MOVE_BPS=8          # min spot move over the lookback window, in bps
ST_LOOKBACK_SEC=3      # window for the spot move + book-staleness check
ST_BOOK_STALE_C=2      # book mid must have moved <= this many cents (i.e. stale)

# ── Entry mechanics ─────────────────────────────────────────────────────────
ST_CONTRACTS=1         # contracts per entry (start at 1)
ST_CROSS_BUFFER_C=1    # pay up to this many cents over the ask to ensure the taker fill
ST_MIN_PRICE_C=20      # only enter when the favored-side ask is in this band
ST_MAX_PRICE_C=80      #   (the edge lives at mid prices, not near-certain ones)
ST_ENTRY_MIN_MINS=2    # don't enter with less than this many minutes left
ST_ENTRY_MAX_MINS=13   # ...or more than this (i.e. only the in-window zone)
ST_SAMPLE_MS=10        # hot-loop period (10ms; win32 timer bumped to 1ms so it's honoured)
ST_PREWARM_SEC=30      # keep the signed HTTP connection hot (< httpx 60s keepalive) so
                       #   orders never pay a cold ~100-300ms TLS handshake. Don't raise past ~50.
ST_PER_TICKER_ONCE=1   # at most one entry per 15m window
ST_CANCEL_REMAINDER=1  # cancel any resting remainder so a taker order never lingers

# ── Hard risk caps (bound the damage) ───────────────────────────────────────
ST_MAX_CONCURRENT=5           # max simultaneously-open windows
ST_MAX_ENTRIES_DAY=50         # max entries per UTC day
ST_MAX_DAILY_SPEND_USD=25     # stop entering once this much has been committed today
                              # (~= max daily loss: a losing binary settles to $0)
